# ====== KREDENSIAL BOT ======
# Token dari @BotFather
BOT_TOKEN=isi_token_botfather

# API_ID & API_HASH dari https://my.telegram.org
API_ID=isi_api_id
API_HASH=isi_api_hash

# ====== KREDENSIAL UNTUK GENERATE SESSION USER ======
# Kosongkan jika ingin sama dengan API_ID / API_HASH di atas
SESSION_API_ID=
SESSION_API_HASH=

# ====== FORCE JOIN CHANNEL (nilai awal, sisanya diatur lewat /admin) ======
FORCE_JOIN=true
ADMIN_CHANNEL=username_channel_tanpa_at
ADMIN_CHANNEL_URL=https://t.me/username_channel

# ====== ADMIN PANEL ======
# User ID Telegram yang boleh akses perintah /admin.
# Pisahkan dengan koma kalau lebih dari satu. Cek ID kamu lewat @userinfobot.
ADMIN_IDS=isi_user_id_kamu

# ====== INFO OWNER ======
OWNER_NAME=Nama Kamu
OWNER_USERNAME=username_telegram_kamu

# ====== LAIN-LAIN ======
CONVERSATION_TIMEOUT=300

# ====== RENDER.COM ======
# Render mengisi otomatis saat deploy sebagai Web Service. Untuk run
# lokal boleh dibiarkan default.
PORT=8080
